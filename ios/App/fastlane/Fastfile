default_platform(:ios)

# Solo-developer setup: no Fastlane Match, no separate certificates repo.
# Auth is via an App Store Connect API key (no Apple ID password needed).
#
# This explicitly fetches a distribution certificate (`cert`) and an
# App Store-type provisioning profile (`sigh`, whose default `type` is
# "appstore") up front, then builds with manual signing pointed at
# exactly that profile. This replaced an earlier attempt using
# `-allowProvisioningUpdates` for fully automatic signing, which kept
# resolving to a Development-type profile during the archive step itself
# (not just at export) — and Development profiles require at least one
# registered test device, which a fresh account has none of. Asking for
# an App Store profile explicitly sidesteps that ambiguous inference.
platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    app_identifier = "com.Niloc.hotstreakhabits"
    keychain_path = File.expand_path("~/Library/Keychains/ci_build-db")
    # Stable across runs (a GitHub secret, not randomly generated per run)
    # so a keychain restored from cache (see the workflow's "Cache CI
    # keychain" step) can actually still be unlocked with it.
    keychain_password = ENV["CI_KEYCHAIN_PASSWORD"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    # The default login.keychain-db on a fresh CI runner has no password
    # set, so when codesign later needs to actually use the certificate's
    # private key, macOS tries to show an interactive "Allow/Deny"
    # permission dialog — which hangs forever with nobody there to click
    # it (this happened on an earlier run: froze at "Signing
    # Cordova.framework", the first real codesign operation, for 15+
    # minutes). A dedicated keychain with a known password lets the
    # partition-list ACL be set correctly so signing can proceed
    # non-interactively.
    #
    # If the cache step in the workflow already restored a keychain from
    # a previous run (with a still-valid certificate inside it), we only
    # need to unlock and re-register it — calling create_keychain again
    # would error ("already exists") and, worse, would defeat the whole
    # point of caching by starting empty. Only create fresh if there's
    # truly nothing there yet.
    if File.exist?(keychain_path)
      sh("security unlock-keychain -p '#{keychain_password}' '#{keychain_path}'")
      sh("security set-keychain-settings -t 3600 -u '#{keychain_path}'")
      sh("security list-keychains -d user -s '#{keychain_path}' ~/Library/Keychains/login.keychain-db")
      sh("security default-keychain -d user -s '#{keychain_path}'")
    else
      create_keychain(
        name: "ci_build",
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false,
      )
    end

    # cert has its own separate keychain_path default (login.keychain-db)
    # that does NOT automatically follow create_keychain's default_keychain
    # setting — without this, the certificate gets created in the old
    # unprotected keychain instead of the one we just set up, silently
    # defeating the whole point of create_keychain above. When the cache
    # already has a valid certificate for this account, cert's own
    # default behavior (force: false) detects and reuses it instead of
    # creating a new one — which is what actually stops every run from
    # burning through Apple's certificate quota.
    begin
      cert(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
      )
    rescue => e
      # This only happens when cert couldn't find a matching private key
      # in THIS keychain (cache miss/eviction) and then hit Apple's
      # Distribution certificate quota trying to create a fresh one. By
      # definition, every certificate already registered on the account
      # is orphaned at that point — none of them have a usable private
      # key anywhere, or cert would have found and reused one instead of
      # failing. Safe to revoke all of them and retry once, using the
      # same Admin-scoped API key already authenticated above, rather
      # than requiring a human to do this by hand in the Apple Developer
      # portal every time the GitHub Actions cache expires from disuse.
      UI.important("cert failed (#{e.message}) — cleaning up orphaned Distribution certificates and retrying once.")

      Spaceship::ConnectAPI::Certificate.all
        .select { |c| c.certificate_type.to_s.include?("DISTRIBUTION") }
        .each do |c|
          begin
            UI.message("Revoking orphaned certificate #{c.id} (#{c.display_name})")
            c.delete!
          rescue => delete_error
            UI.important("Could not revoke certificate #{c.id}: #{delete_error.message}")
          end
        end

      cert(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
      )
    end

    sigh(
      api_key: api_key,
      app_identifier: app_identifier,
    )

    # Apple rejects any TestFlight upload that doesn't have a higher
    # build number than the last one for this app. Rather than a human
    # remembering to bump a hardcoded number before every future update,
    # ask App Store Connect what the last uploaded build number actually
    # was and increment from there automatically.
    last_build = latest_testflight_build_number(api_key: api_key, app_identifier: app_identifier)
    increment_build_number(build_number: last_build + 1, xcodeproj: "App.xcodeproj")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      team_id: ENV["APPLE_TEAM_ID"],
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
