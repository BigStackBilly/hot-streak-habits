default_platform(:ios)

# Same solo-developer setup as Hot Streak Habits' Fastfile (see the root
# repo's ios/App/fastlane/Fastfile for the full rationale on the keychain
# dance, manual signing, and build-number auto-increment). The one addition
# here is `produce` at the top: unlike Hot Streak, this app doesn't exist
# yet on the Apple Developer Portal / App Store Connect, so it needs to be
# registered before `cert`/`sigh` have anything to attach to. `produce` is
# safe to call on every run — wrapped in a rescue so a second run (once the
# app already exists) doesn't fail the whole lane.
platform :ios do
  desc "Register the app (first run only) and upload a new build to TestFlight"
  lane :beta do
    app_identifier = "com.Niloc.eggcelence"
    app_name = "Eggcelence"
    sku = "eggcelence2026"
    keychain_path = File.expand_path("~/Library/Keychains/ci_build-db")
    keychain_password = ENV["CI_KEYCHAIN_PASSWORD"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    # `produce` can't register a brand-new app here: its Developer Portal
    # App ID creation unconditionally requires legacy username/password
    # Spaceship::Portal auth, even with a ConnectAPI token set globally
    # (confirmed by trial — it kept failing with "No value found for
    # 'username'" no matter how the API key was passed/configured). Bundle
    # ID + app registration is called directly against the App Store
    # Connect API instead, via the same ConnectAPI client cert/sigh below
    # already use successfully with API-key-only auth.
    begin
      unless Spaceship::ConnectAPI::BundleId.find(app_identifier)
        Spaceship::ConnectAPI::BundleId.create(name: app_name, identifier: app_identifier, platform: "IOS")
        UI.message("Registered new Bundle ID #{app_identifier}")
      else
        UI.message("Bundle ID #{app_identifier} already registered, continuing")
      end
    rescue => e
      UI.message("Bundle ID registration skipped/failed, continuing (#{e.message})")
    end

    begin
      unless Spaceship::ConnectAPI::App.find(app_identifier)
        Spaceship::ConnectAPI::App.create(
          name: app_name,
          version_string: "1.0",
          sku: sku,
          primary_locale: "en-US",
          bundle_id: app_identifier,
          platforms: ["IOS"],
        )
        UI.message("Created App Store Connect app record for #{app_name}")
      else
        UI.message("App Store Connect app record for #{app_identifier} already exists, continuing")
      end
    rescue => e
      UI.message("App Store Connect app creation skipped/failed, continuing (#{e.message})")
    end

    if File.exist?(keychain_path)
      sh("security unlock-keychain -p '#{keychain_password}' '#{keychain_path}'")
      sh("security set-keychain-settings -t 3600 -u '#{keychain_path}'")
      sh("security list-keychains -d user -s '#{keychain_path}' ~/Library/Keychains/login.keychain-db")
      sh("security default-keychain -d user -s '#{keychain_path}'")
    else
      create_keychain(
        name: "ci_build",
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false,
      )
    end

    cert(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: keychain_password,
    )

    sigh(
      api_key: api_key,
      app_identifier: app_identifier,
    )

    last_build = latest_testflight_build_number(api_key: api_key, app_identifier: app_identifier)
    increment_build_number(build_number: last_build + 1, xcodeproj: "App.xcodeproj")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      team_id: ENV["APPLE_TEAM_ID"],
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Push App Store listing metadata/screenshots and submit the latest build for review"
  lane :release do
    app_identifier = "com.Niloc.eggcelence"

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    # Work around a confirmed, still-open fastlane bug (fastlane/fastlane#20538,
    # "Uploading the very first version of my app yields `No data`"): deliver's
    # upload_metadata unconditionally calls fetch_app_store_review_detail,
    # which crashes trying to parse an empty response when no review detail
    # exists yet for a brand-new app version. Pre-creating that record
    # directly means it already exists by the time deliver looks for it.
    begin
      app = Spaceship::ConnectAPI::App.find(app_identifier)
      version = app.get_app_store_versions.find { |v| v.version_string == "1.0" }
      version ||= app.create_app_store_version!(platform: "IOS", version_string: "1.0")

      version.create_app_store_review_detail(
        attributes: {
          contactFirstName: "Niloc",
          contactLastName: "Dekkers",
          contactPhone: "+31627240888",
          contactEmail: "hotstreakhabits@gmail.com",
          demoAccountRequired: false,
        },
      )
      UI.message("Created App Store review detail contact info")
    rescue => e
      UI.message("Review detail pre-creation skipped/failed (may already exist), continuing (#{e.message})")
    end

    # Manual release on purpose — even once Apple approves this, it should
    # stay dark until a human explicitly flips it live, not go public the
    # moment review clears.
    #
    # Apple requires age rating, App Privacy data-usage declaration, and
    # pricing to be set before a first submission will be accepted - none
    # of these are automatable here (pricing hits a hard API-version
    # mismatch in this fastlane release, and age rating has 20+ fields in
    # Apple's current questionnaire, too many to safely guess at). These
    # three need a ~2min manual pass per app in App Store Connect before
    # this lane's submit_for_review will actually succeed.
    deliver(
      api_key: api_key,
      app_identifier: app_identifier,
      app_version: "1.0",
      submit_for_review: true,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
  end

  # Fills in Apple's age-rating questionnaire. Apple expanded it and moved the
  # declaration onto AppInfo (ASC API 1.3), so every attribute reads nil and
  # deliver cannot put a version into a reviewable state.
  #
  # These answers are not guesses. Every app in this repo is offline and
  # local-only: no network calls, no ads, no accounts, no messaging, and no
  # user content shared between people. The optional unlocks are direct
  # purchases of colour themes, not randomised rewards. So every content
  # descriptor is NONE and every capability flag is false.
  #
  # Apple's API rejects one wrongly-typed attribute at a time and names the
  # type it wanted, so rather than burn a CI run per attribute this parses the
  # rejection, flips that attribute, and retries until it converges.
  desc "Set the age rating declaration to no-objectionable-content"
  lane :set_age_rating do
    app_identifier = ENV["AGE_RATING_APP_ID"] || "com.Niloc.eggcelence"

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    app = Spaceship::ConnectAPI::App.find(app_identifier)
    UI.important("app: #{app_identifier} (#{app.id})")

    info = app.fetch_edit_app_info
    UI.user_error!("No editable app info for #{app_identifier}") if info.nil?

    decl = info.fetch_age_rating_declaration
    UI.user_error!("No age rating declaration for #{app_identifier}") if decl.nil?
    UI.important("declaration: #{decl.id}")

    string_descriptors = %w[
      alcoholTobaccoOrDrugUseOrReferences
      contests
      gamblingSimulated
      gunsOrOtherWeapons
      horrorOrFearThemes
      matureOrSuggestiveThemes
      medicalOrTreatmentInformation
      profanityOrCrudeHumor
      sexualContentGraphicAndNudity
      sexualContentOrNudity
      violenceCartoonOrFantasy
      violenceRealistic
      violenceRealisticProlongedGraphicOrSadistic
      healthOrWellnessTopics
    ]

    bool_flags = %w[
      gambling
      lootBox
      unrestrictedWebAccess
      messagingAndChat
      userGeneratedContent
      advertising
      parentalControls
      ageAssurance
      socialMedia
      socialMediaAgeRestricted
    ]

    attrs = {}
    string_descriptors.each { |k| attrs[k] = "NONE" }
    bool_flags.each { |k| attrs[k] = false }

    UI.important("starting with #{attrs.size} attributes")

    corrections = 0
    12.times do |round|
      begin
        decl.update(attributes: attrs)
        UI.success("Age rating declaration updated for #{app_identifier} after #{corrections} type correction(s)")
        break
      rescue => e
        msg = e.message.to_s

        # Wrong type: the API says which it wanted, so flip just that one.
        if msg =~ /attribute '(\w+)'\. Expected a (\w+) but got (\w+)/
          name, expected = Regexp.last_match(1), Regexp.last_match(2)
          attrs[name] = (expected == "BOOLEAN") ? false : "NONE"
          corrections += 1
          UI.important("round #{round}: #{name} -> #{expected}")
          next
        end

        # Unknown/unwritable attribute: drop it and carry on.
        if msg =~ /attribute '(\w+)'/ && msg =~ /not permitted|unknown|cannot be/i
          name = Regexp.last_match(1)
          attrs.delete(name)
          corrections += 1
          UI.important("round #{round}: dropping #{name}")
          next
        end

        UI.error("unrecoverable: #{e.class}")
        UI.error(msg[0, 3000])
        raise
      end
    end

    # contentRightsDeclaration is the last attribute the submit lane reports as
    # missing. It sits on the App itself rather than the age rating
    # declaration. None of these apps ship third-party content: every asset is
    # generated in-app or written for it.
    [
      "DOES_NOT_USE_THIRD_PARTY_CONTENT",
      "USES_THIRD_PARTY_CONTENT",
    ].each do |value|
      begin
        app.update(attributes: { contentRightsDeclaration: value })
        UI.success("contentRightsDeclaration set to #{value}")
        break
      rescue => e
        UI.important("contentRightsDeclaration=#{value} rejected: #{e.message.to_s[0, 200]}")
      end
    end

    fresh = app.fetch_edit_app_info.fetch_age_rating_declaration
    fresh.instance_variables.sort.each do |iv|
      UI.important("AFTER #{iv} = #{fresh.instance_variable_get(iv).inspect}")
    end
  end

  desc "List every app record in the App Store Connect account"
  lane :list_apps do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    apps = Spaceship::ConnectAPI::App.all
    UI.important("ASCLIST count=#{apps.size}")
    apps.sort_by { |a| a.bundle_id.to_s }.each do |a|
      UI.important("ASCLIST #{a.bundle_id} | #{a.name} | sku=#{a.sku}")
    end
  end

  # App record creation is not available through the API, but Bundle ID
  # registration is — and an unregistered Bundle ID will not show up in App
  # Store Connect's dropdown when creating the app. So register them here to
  # cut a step out of the manual work.
  desc "Register Bundle IDs for the apps that still need App Store Connect records"
  lane :register_bundle_ids do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    wanted = {
      "com.Niloc.wordday"  => "Wordday",
      "com.Niloc.spendlog" => "TapSpend",
      "com.Niloc.typly"    => "Typly",
      "com.Niloc.numbly"   => "Numbly",
      "com.Niloc.rankly"   => "Rankly",
      "com.Niloc.gridly"   => "Gridly",
      "com.Niloc.pitchly"  => "Pitchly",
      "com.Niloc.soonly"   => "Soonly",
    }

    wanted.each do |identifier, name|
      begin
        existing = Spaceship::ConnectAPI::BundleId.find(identifier)
        if existing
          UI.important("BUNDLE #{identifier} already registered")
        else
          Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
          UI.success("BUNDLE #{identifier} registered as #{name}")
        end
      rescue => e
        UI.error("BUNDLE #{identifier} failed: #{e.class}: #{e.message.to_s[0, 160]}")
      end
    end
  end

end
